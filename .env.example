# Non-secret configuration only. Anything named VITE_* is embedded in the public bundle: never put keys, tokens or credentials here.

# Origin of the Spring Boot API. Leave empty to use the same origin (recommended: reverse-proxy /api and /actuator).
# Endpoint paths already include "/api/v1", so do NOT append it here.
# VITE_API_BASE_URL=https://api.example.com

# Development proxy target used by `npm run dev` (default http://localhost:8080).
VITE_DEV_API_TARGET=http://localhost:8080

# Lets the Knowledge screen call the backend internal RAG test endpoints (chunk / embeddings / ask) until production endpoints exist.
# They have no ownership checks, so keep this OFF in production.
# Default: ON in dev builds, OFF in production builds. Set =false to disable in dev, or =true to enable explicitly in a production build.
# VITE_ENABLE_RAG_TEST_ENDPOINTS=true
